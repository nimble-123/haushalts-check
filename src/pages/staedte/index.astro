---
import { KREISE, LAENDER, STAEDTE } from '../../data';
import Base from '../../layouts/Base.astro';

const gruppen = LAENDER.map((l) => ({
  land: l,
  orte: [...STAEDTE, ...KREISE].filter((s) => s.land === l.code),
})).filter((g) => g.orte.length);
---
<Base title="Alle Städte und Landkreise | Haushalts-Check" description={`Haushalts-Check für alle ${STAEDTE.length} kreisfreien Städte und ${KREISE.length} Landkreise in Deutschland.`}>
  <div class="page">
    <h1>Alle Städte und Landkreise</h1>
    <p class="prose intro">Wähl deine kreisfreie Stadt oder deinen Landkreis. Für einzelne Gemeinden im Kreis gibt es keine eigene Seite; dort passt der Landkreis.</p>
    <div class="cols">
      {gruppen.map((g) => (
        <section>
          <h2>{g.land.name}</h2>
          <ul>
            {g.orte.map((s) => <li><a href={`/stadt/${s.slug}/`}>{s.name}</a></li>)}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>
<style>
  h1 { font: 700 clamp(38px, 6vw, 52px)/1.02 var(--font-display); letter-spacing: -0.025em; margin: 48px 0 12px; }
  .intro { color: var(--ink-2); margin-bottom: 40px; font-size: 19px; }
  .cols { columns: 260px; column-gap: 40px; }
  section { break-inside: avoid; margin-bottom: 28px; }
  h2 { font: 650 20px/1.2 var(--font-display); padding-bottom: 8px; border-bottom: 3px solid var(--ink); margin-bottom: 4px; }
  ul { list-style: none; margin: 0; padding: 0; }
  a { display: flex; align-items: center; min-height: 40px; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--rule); }
  a:hover { background: var(--surface); }
</style>
