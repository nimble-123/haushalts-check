---
import Check from '../components/Check.astro';
import { landVon, STAEDTE } from '../data';
import { START_STADT } from '../data/eckwerte';
import Base from '../layouts/Base.astro';

const stadt = STAEDTE.find((s) => s.slug === START_STADT) ?? STAEDTE[0];
---
<Base title="Haushalts-Check: Wohin geht deine Lohnsteuer?" description="Rechne aus, wie viel deiner Lohnsteuer an Bund, Land und deine Stadt geht und wofür sie es ausgeben. Für alle kreisfreien Städte, mit Bundeshaushalt 2026.">
  <Check stadt={stadt} land={landVon(stadt)} />
</Base>
