---
import { ausgabeVergleich, gemeindeEbene, LAENDER, STAEDTE } from '../data';
import { abstimmungSatz, BUND_GESAMT, EINNAHMEN, EINZELPLAENE, ENTWICKLUNG, ENTWURF_2027_GESAMT } from '../data/bund';
import { MEDIAN_BRUTTO, MEDIAN_BRUTTO_QUELLE } from '../data/eckwerte';
import type { Land, Stadt } from '../data/types';
import { KONSUM } from '../lib/konsum';
import { ergebnisSatz } from '../lib/satz';
import { ANTEIL, berechne } from '../lib/steuer';
import { pct, satzText } from '../lib/text';

interface Props {
  stadt: Stadt;
  land: Land;
  /** Stadtseiten nennen die Stadt in der Überschrift, die Startseite nicht */
  stadtImTitel?: boolean;
}
const { stadt, land, stadtImTitel = false } = Astro.props;

const gruppen = LAENDER.map((l) => ({ land: l, staedte: STAEDTE.filter((s) => s.land === l.code) })).filter(
  (g) => g.staedte.length,
);
const gem = gemeindeEbene(stadt);
const arten = ausgabeVergleich(stadt);
// Für „In meiner Nähe“: nur Slug und Koordinaten, die Suche läuft im Browser
const orte = STAEDTE.filter((s) => s.lat && s.lon).map((s) => [s.slug, s.lat, s.lon] as const);
const daten = { stadt, land, gem, arten, orte, median: MEDIAN_BRUTTO };

// Beim Build vorab: Ergebnissatz für den Median (Suchmaschinen, Seiten ohne JavaScript, erster Eindruck)
const vorab = ergebnisSatz(
  berechne({ brutto: MEDIAN_BRUTTO, pkv: false, pkvMonat: 0, kinderlos: true, kirche: 0 }),
  stadt,
  land,
  gem,
);
const mrd = (v: number) => `${v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} Mrd €`;
const groesster = [...EINZELPLAENE].sort((a, b) => b.v - a.v)[0];
const labelFluss = `Sankey-Diagramm: ${EINNAHMEN.map((e) => `${e.name} ${mrd(e.v)}`).join(', ')} fließen in den Bundeshaushalt von ${mrd(BUND_GESAMT)} und weiter in die Einzelpläne; größter Posten ${groesster.name} mit ${mrd(groesster.v)}. Alle Werte in der Tabelle darunter.`;
const labelEntwicklung = `Säulendiagramm der Bundesausgaben: ${ENTWICKLUNG.map((d) => `${d.jahr} ${mrd(d.v)} (${d.status})`).join(', ')}.`;
---
<section class="hero page" aria-labelledby="hero-h">
  <div class="eingabe">
    <h1 id="hero-h" class="t-title">Wohin geht dein Geld{stadtImTitel && ` in ${stadt.name}`}?</h1>
    <p class="rs-satz">
      Ich verdiene
      <input id="brutto" class="rs-betrag" type="text" inputmode="numeric" autocomplete="off" value={MEDIAN_BRUTTO.toLocaleString('de-DE')} aria-label="Jahresbrutto in Euro" />
      € brutto im Jahr und wohne in
      <select id="stadt" class="rs-auswahl" aria-label="Stadt">
        {gruppen.map((g) => (
          <optgroup label={g.land.name}>
            {g.staedte.map((s) => <option value={s.slug} selected={s.slug === stadt.slug}>{s.name}</option>)}
          </optgroup>
        ))}
      </select><span class="punkt">.</span>
    </p>
    <div class="satz-zeile">
      <button type="button" class="rs-textknopf" id="naehe"><i class="ort" aria-hidden="true"></i>In meiner Nähe</button>
      <span class="status" id="naehe-status" aria-live="polite"></span>
      <span class="vorbelegt" id="vorbelegt">Vorbelegt mit dem <a href={MEDIAN_BRUTTO_QUELLE.url}>mittleren Bruttolohn für Vollzeit 2025</a> (Destatis).</span>
    </div>

    <details class="rs-aufklapper mehr">
      <summary><b>Weitere Angaben</b><span id="mehr-sum">Steuerklasse I</span></summary>
      <div class="rs-felder">
        <label class="rs-feld"><span>Krankenversicherung</span>
          <select id="kv"><option value="gkv">gesetzlich</option><option value="pkv">privat</option></select>
        </label>
        <label class="rs-feld" id="pkvwrap" hidden><span>PKV-Beitrag €/Monat, dein Anteil</span>
          <input id="pkv" type="number" inputmode="numeric" value="550" min="0" step="10" />
        </label>
        <label class="rs-feld"><span>Kirchensteuer</span>
          <select id="kist"><option value="0">keine</option><option value={String(land.kirchensteuer)}>{String(land.kirchensteuer * 100)} %</option></select>
        </label>
        <label class="rs-schalter"><input id="kinderlos" type="checkbox" checked /> kinderlos</label>
      </div>
      <p class="hinweis">Gerechnet wird mit Steuerklasse I. Deine Angaben merkt sich nur dieser Browser. <button type="button" class="rs-textknopf" id="vergessen">Eingaben vergessen</button></p>
    </details>

    <p class="ergebnis" id="result" aria-live="polite" set:html={vorab}></p>
    <noscript><p class="ohne-js">Die Rechner und Diagramme brauchen JavaScript. Der Satz oben gilt für den mittleren Bruttolohn; alle Quellen stehen unter <a href="/methodik/">So ist gerechnet</a>, alle Städte unter <a href="/staedte/">Städte</a>.</p></noscript>
  </div>

  <figure class="hundert">
    <figcaption>Von 100 € deiner Abgaben</figcaption>
    <div class="rs-raster" id="raster" role="img" aria-label=""></div>
    <ul class="zweckliste" id="zweck"></ul>
  </figure>
</section>

<div class="page">
  <section class="chapter" aria-labelledby="k1">
    <header class="rs-kapitel">
      <h2 id="k1"><span class="nr">1</span>Dein Brutto</h2>
      <p>Was vom Gehalt abgeht, bevor es auf deinem Konto landet.</p>
    </header>

    <div class="figure konsum-wahl">
      <label class="rs-schalter"><input id="konsum" type="checkbox" /> Konsumsteuern einrechnen</label>
      <p class="sub">Auch was du ausgibst, ist besteuert: Mehrwert-, Energie-, Strom- und Versicherungsteuer. Geschätzt aus dem typischen Konsum Alleinlebender mit deinem Netto <span class="rs-schaetzung">≈ Schätzung</span></p>
    </div>

    <div class="figure">
      <div class="rs-anteil" id="anteil" role="img"></div>
      <ul class="rs-anteil-legende" id="anteil-lg" style="list-style:none;padding:0"></ul>
    </div>
    <div class="rs-kennzahlen figure" id="pk"></div>

    <details class="rs-aufklapper figure" data-neu-zeichnen>
      <summary><b>Dein Abgaben-Kalender</b><span id="cal-sum"></span></summary>
      <p class="sub">Verteilt man das Jahresbrutto der Reihe nach, arbeitest du bis zu diesen Tagen für die jeweilige Kasse.</p>
      <div class="rs-panel" id="cal"></div>
    </details>

    <details class="rs-aufklapper figure" data-neu-zeichnen>
      <summary><b>Abgabenquote nach Einkommen</b><span id="quote-sum"></span></summary>
      <p class="sub">Anteil vom Brutto bei gleichen Angaben. Gestrichelt: Beitragsbemessungsgrenzen, ab denen die Sozialabgaben nicht mehr steigen.</p>
      <div class="rs-panel"><svg id="s5" role="img" aria-label="Liniendiagramm: Abgabenquote gesamt, Steuern und Sozialabgaben in Prozent des Bruttos von 15.000 bis 160.000 Euro, mit Markierung deines Einkommens."></svg>
      <ul class="rs-legende" id="lg5"></ul></div>
    </details>
  </section>

  <section class="chapter" aria-labelledby="k2">
    <header class="rs-kapitel">
      <h2 id="k2"><span class="nr">2</span>Wohin es fließt</h2>
      <p>Lohnsteuer geht zu {satzText(ANTEIL.bund)} an den Bund, zu {satzText(ANTEIL.land)} an {land.name} und zu {satzText(ANTEIL.gemeinde)} an {stadt.name}. Jede Ebene verteilt ihren Anteil so wie ihren ganzen Haushalt.</p>
      <p id="k2-konsum" hidden>Die geschätzten Konsumsteuern fließen mit: Die Mehrwertsteuer teilen sich Bund ({pct(KONSUM.mwstVerteilung.bund)}), Länder ({pct(KONSUM.mwstVerteilung.land)}) und Gemeinden ({pct(KONSUM.mwstVerteilung.gemeinde)}); Energie-, Strom- und Versicherungsteuer gehen an den Bund.</p>
    </header>

    <div class="figure">
      <h3>Dein Geld, Ebene für Ebene {gem.schaetzung && <span class="rs-schaetzung">≈ Stadt geschätzt</span>}</h3>
      <div class="steuerung">
        <label class="rs-feld"><span>Aufschlüsseln</span>
          <select id="split">
            <option value="all">Bund, Land und Stadt</option>
            <option value="bund">nur Bund</option>
            <option value="land">nur {land.name}</option>
            <option value="gem">nur {stadt.name}</option>
          </select>
        </label>
        <label class="rs-schalter"><input id="ag" type="checkbox" /> Arbeitgeberanteil mitzählen</label>
        <label class="rs-schalter"><input id="shownetto" type="checkbox" /> Netto zeigen</label>
        <div class="rs-segment" id="unit" role="group" aria-label="Zeitraum">
          <button type="button" data-u="m" aria-pressed="true">pro Monat</button>
          <button type="button" data-u="y" aria-pressed="false">pro Jahr</button>
        </div>
      </div>
      <div class="rs-panel">
        <p class="hint">Diagramm seitlich wischen</p>
        <div class="rs-scroll" tabindex="0" role="region" aria-label="Dein Geld, Ebene für Ebene (seitlich scrollbar)"><svg id="s2" role="img" aria-label="Sankey-Diagramm deiner Abgaben: von Lohnsteuer, Soli, Kirchensteuer und Sozialversicherung über Bund, Land und Stadt in die Ausgabenbereiche. Alle Beträge stehen in der Tabelle weiter unten."></svg></div>
        <ul class="rs-legende" id="lg2"></ul>
      </div>
    </div>

    {arten && (
      <div class="figure">
        <h3>Was {stadt.name} tatsächlich ausgibt</h3>
        <p class="sub">Auszahlungen {arten.jahr}{arten.vorlaeufig ? ' (vorläufig)' : ''} nach Art, in € je Einwohner. Der Strich zeigt den Durchschnitt aller {arten.anzahl} kreisfreien Städte. Rechts dein Gemeindeanteil, nach denselben Anteilen verteilt.</p>
        <div class="rs-panel" id="arten"></div>
      </div>
    )}

    <details class="rs-aufklapper figure" data-neu-zeichnen>
      <summary><b>Alle Töpfe, sortiert</b><span id="toepfe-sum"></span></summary>
      <p class="sub" id="barsub"></p>
      <div class="rs-panel"><svg id="s3" role="img" aria-label="Sortiertes Balkendiagramm deiner Abgaben je Topf in Euro. Werte auch in der Tabelle unten."></svg>
      <ul class="rs-legende" id="lg3"></ul></div>
    </details>

    <details class="rs-aufklapper figure">
      <summary><b>Alle Posten als Tabelle</b><span id="tcount"></span></summary>
      <p class="sub" id="tsub"></p>
      <div class="rs-panel rs-scroll" tabindex="0" role="region" aria-label="Alle Posten (seitlich scrollbar)"><table class="rs-tabelle" id="tbl"><thead><tr><th>Posten</th><th>Anteil</th><th class="uy">€ / Monat</th></tr></thead><tbody></tbody></table></div>
    </details>
  </section>

  <section class="chapter" aria-labelledby="k3">
    <header class="rs-kapitel">
      <h2 id="k3"><span class="nr">3</span>Der Bundeshaushalt im Ganzen</h2>
      <p>Soll-Zahlen des Haushaltsgesetzes 2026. {abstimmungSatz()}</p>
    </header>
    <div class="rs-kennzahlen figure" id="bk"></div>

    <div class="figure">
      <h3>Woher das Geld kommt, wohin es geht</h3>
      <div class="steuerung">
        <div class="rs-segment" id="bundansicht" role="group" aria-label="Darstellung">
          <button type="button" data-ansicht="fluss" aria-pressed="true">Als Fluss</button>
          <button type="button" data-ansicht="flaeche" aria-pressed="false">Als Fläche</button>
        </div>
      </div>
      <p class="sub" id="bundsub">Einnahmen, Bundeshaushalt, Einzelpläne. Antippen oder Überfahren zeigt Beträge.</p>
      <div class="rs-panel">
        <div id="ansicht-fluss">
          <p class="hint">Diagramm seitlich wischen</p>
          <div class="rs-scroll" tabindex="0" role="region" aria-label="Bundeshaushalt als Fluss (seitlich scrollbar)"><svg id="s1" role="img" aria-label={labelFluss}></svg></div>
        </div>
        <div id="ansicht-flaeche" hidden>
          <svg id="s6" role="img" aria-label="Treemap des Bundeshaushalts 2026 nach Einzelplänen; Arbeit und Soziales belegt über ein Drittel der Fläche."></svg>
        </div>
        <ul class="rs-legende" id="lg1"></ul>
      </div>
    </div>

    <div class="figure">
      <h3>Was sich 2027 ändern soll</h3>
      <p class="sub">Regierungsentwurf 2027 ({ENTWURF_2027_GESAMT.toLocaleString('de-DE')} Mrd €) gegenüber Soll 2026, für die Einzelpläne mit veröffentlichten Entwurfszahlen. Noch nicht beschlossen.</p>
      <div class="rs-panel"><svg id="s9" role="img" aria-label="Balkendiagramm der Veränderungen 2027 gegenüber 2026: Verteidigung plus 27 Milliarden, Bundesschuld plus 10 Milliarden, Gesundheit minus 7,4 Milliarden."></svg></div>
    </div>

    <div class="figure">
      <h3>Entwicklung der Bundesausgaben</h3>
      <p class="sub">Kernhaushalt in Mrd €: 2025 und 2026 beschlossen, 2027 Entwurf, ab 2028 Finanzplan.</p>
      <div class="rs-panel"><svg id="s10" role="img" aria-label={labelEntwicklung}></svg></div>
    </div>

    <details class="rs-aufklapper figure">
      <summary><b>Bundeshaushalt 2026 als Tabelle</b><span>{EINZELPLAENE.length} Einzelpläne und {EINNAHMEN.length} Einnahmearten</span></summary>
      <div class="rs-panel rs-scroll" tabindex="0" role="region" aria-label="Bundeshaushalt 2026 als Tabelle (seitlich scrollbar)">
        <table class="rs-tabelle">
          <thead><tr><th>Einzelplan</th><th>Anteil</th><th>Mrd €</th></tr></thead>
          <tbody>
            {[...EINZELPLAENE].sort((a, b) => b.v - a.v).map((e) => (
              <tr><td>EP {e.n} {e.name}</td><td>{(e.v / BUND_GESAMT * 100).toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} %</td><td>{e.v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}</td></tr>
            ))}
            <tr><td><b>Ausgaben gesamt</b></td><td>100 %</td><td><b>{BUND_GESAMT.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}</b></td></tr>
            <tr><th colspan="3" scope="colgroup" class="zwischen">Finanziert durch</th></tr>
            {EINNAHMEN.map((e) => (
              <tr><td>{e.name}</td><td>{(e.v / BUND_GESAMT * 100).toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} %</td><td>{e.v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>

    <p class="datenstand">Datenstand: Bund Soll 2026; {land.name} Rechnungsergebnis {land.jahr}; {stadt.name} {gem.schaetzung ? `geschätzt aus den Gemeinden des Landes ${gem.jahr}` : `wie das Land ${gem.jahr}`}{arten ? `, Ausgabearten ${arten.jahr}${arten.vorlaeufig ? ' (vorläufig)' : ''}` : ''}. <a href="/methodik/">Quellen und Rechenweg</a></p>

    <p class="weiter"><a href="/rente/">Rentenbeitrag: Staat oder ETF? Vergleich mit deinen Angaben</a></p>
  </section>
</div>

<script type="application/json" id="daten" set:html={JSON.stringify(daten).replace(/</g, '\\u003c')}></script>
<script>
  import { start } from '../scripts/check';
  start();
</script>

<style>
  .hero {
    display: grid; gap: var(--space-12) var(--space-12); align-items: start;
    padding-block: var(--space-12) 0;
  }
  @media (min-width: 960px) {
    .hero { grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr); }
  }
  .eingabe { display: grid; gap: var(--space-6); min-width: 0; }
  /* Schmal: Stadtauswahl immer in eigener Zeile, damit der Umbruch nicht von wenigen Pixeln Schriftbreite abhängt */
  @media (max-width: 600px) {
    .rs-satz .rs-auswahl { display: block; width: 100%; margin-top: var(--space-2); }
    .rs-satz .punkt { display: none; }
  }
  @media (max-width: 600px) { .t-title { font-size: 38px; } .rs-satz { font-size: 19px; } }
  .mehr { max-width: 36em; }
  .mehr .rs-felder { align-items: end; }
  .hinweis { margin: var(--space-3) 0 0; font-size: 14px; color: var(--ink-3); }
  .satz-zeile { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); margin-top: calc(-1 * var(--space-3)); font-size: 14.5px; color: var(--ink-3); }
  .satz-zeile a { color: inherit; }
  .status:empty { display: none; }
  .ort { width: 12px; height: 12px; border-radius: 50% 50% 50% 0; rotate: -45deg; box-shadow: inset 0 0 0 2px currentColor; display: inline-block; margin-right: 6px; }
  .ergebnis { margin: 0; font-size: 21px; line-height: 1.7; max-width: 32em; }

  .hundert { margin: 0; display: grid; gap: var(--space-4); min-width: 0; }
  .hundert figcaption { font: 650 19px/1.35 var(--font-text); }
  .hundert .rs-raster { max-width: 340px; }

  .rs-kapitel .nr { color: var(--ink-3); margin-right: 0.45em; }
  .konsum-wahl > .sub { margin-bottom: 0; }
  .steuerung { display: flex; flex-wrap: wrap; align-items: end; gap: var(--space-3) var(--space-6); margin: var(--space-4) 0; }
  .steuerung .rs-feld { min-width: 220px; }
  .figure > h3 { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .ohne-js { color: var(--ink-2); font-size: 15px; }
  .datenstand { color: var(--ink-3); font-size: 14.5px; margin-top: var(--space-12); }
  .datenstand a { color: inherit; }
  .zwischen { text-align: left; padding-top: 18px; color: var(--ink); font-size: 15px; font-weight: 600; }
  .weiter { font-size: 19px; font-weight: 600; }
</style>
