---
import { ausgabeVergleich, gemeindeEbene, LAENDER, STAEDTE } from '../data';
import { ABSTIMMUNG_2027, ENTWURF_2027_GESAMT } from '../data/bund';
import type { Land, Stadt } from '../data/types';

interface Props {
  stadt: Stadt;
  land: Land;
}
const { stadt, land } = Astro.props;

const gruppen = LAENDER.map((l) => ({ land: l, staedte: STAEDTE.filter((s) => s.land === l.code) })).filter(
  (g) => g.staedte.length,
);
const gem = gemeindeEbene(stadt);
const arten = ausgabeVergleich(stadt);
const daten = { stadt, land, gem, arten };
---
<section class="hero page" aria-labelledby="hero-h">
  <div class="eingabe">
    <h1 id="hero-h" class="t-title">Wohin geht dein Geld?</h1>
    <p class="rs-satz">
      Ich verdiene
      <input id="brutto" class="rs-betrag" type="text" inputmode="numeric" autocomplete="off" value="85.000" aria-label="Jahresbrutto in Euro" />
      € brutto im Jahr und wohne in
      <select id="stadt" class="rs-auswahl" aria-label="Stadt">
        {gruppen.map((g) => (
          <optgroup label={g.land.name}>
            {g.staedte.map((s) => <option value={s.slug} selected={s.slug === stadt.slug}>{s.name}</option>)}
          </optgroup>
        ))}
      </select>.
    </p>

    <details class="rs-aufklapper mehr">
      <summary><b>Weitere Angaben</b><span id="mehr-sum">Steuerklasse I</span></summary>
      <div class="rs-felder">
        <label class="rs-feld"><span>Krankenversicherung</span>
          <select id="kv"><option value="gkv">gesetzlich</option><option value="pkv">privat</option></select>
        </label>
        <label class="rs-feld" id="pkvwrap" hidden><span>PKV-Beitrag €/Monat, dein Anteil</span>
          <input id="pkv" type="number" inputmode="numeric" value="550" min="0" step="10" />
        </label>
        <label class="rs-feld"><span>Kirchensteuer</span>
          <select id="kist"><option value="0">keine</option><option value={String(land.kirchensteuer)}>{String(land.kirchensteuer * 100)} %</option></select>
        </label>
        <label class="rs-schalter"><input id="kinderlos" type="checkbox" checked /> kinderlos</label>
      </div>
      <p class="hinweis">Gerechnet wird mit Steuerklasse I.</p>
    </details>

    <p class="ergebnis" id="result" aria-live="polite"></p>
  </div>

  <figure class="hundert">
    <figcaption>Von 100 € deiner Abgaben</figcaption>
    <div class="rs-raster" id="raster" role="img" aria-label=""></div>
    <ul class="zweckliste" id="zweck"></ul>
  </figure>
</section>

<div class="page">
  <section class="chapter" aria-labelledby="k1">
    <header class="rs-kapitel">
      <h2 id="k1"><span class="nr">1</span>Dein Brutto</h2>
      <p>Was vom Gehalt abgeht, bevor es auf deinem Konto landet.</p>
    </header>

    <div class="figure">
      <div class="rs-anteil" id="anteil" role="img"></div>
      <ul class="rs-anteil-legende" id="anteil-lg" style="list-style:none;padding:0"></ul>
    </div>
    <div class="rs-kennzahlen figure" id="pk"></div>

    <details class="rs-aufklapper figure" data-neu-zeichnen>
      <summary><b>Dein Abgaben-Kalender</b><span id="cal-sum"></span></summary>
      <p class="sub">Verteilt man das Jahresbrutto der Reihe nach, arbeitest du bis zu diesen Tagen für die jeweilige Kasse.</p>
      <div class="rs-panel" id="cal"></div>
    </details>

    <details class="rs-aufklapper figure" data-neu-zeichnen>
      <summary><b>Abgabenquote nach Einkommen</b><span id="quote-sum"></span></summary>
      <p class="sub">Anteil vom Brutto bei gleichen Angaben. Gestrichelt: Beitragsbemessungsgrenzen, ab denen die Sozialabgaben nicht mehr steigen.</p>
      <div class="rs-panel"><svg id="s5" role="img" aria-label="Liniendiagramm: Abgabenquote gesamt, Steuern und Sozialabgaben in Prozent des Bruttos von 15.000 bis 160.000 Euro, mit Markierung deines Einkommens."></svg>
      <ul class="rs-legende" id="lg5"></ul></div>
    </details>
  </section>

  <section class="chapter" aria-labelledby="k2">
    <header class="rs-kapitel">
      <h2 id="k2"><span class="nr">2</span>Wohin es fließt</h2>
      <p>Lohnsteuer geht zu 42,5 % an den Bund, zu 42,5 % an {land.name} und zu 15 % an {stadt.name}. Jede Ebene verteilt ihren Anteil so wie ihren ganzen Haushalt.</p>
    </header>

    <div class="figure">
      <h3>Dein Geld, Ebene für Ebene {gem.schaetzung && <span class="rs-schaetzung">≈ Stadt geschätzt</span>}</h3>
      <div class="steuerung">
        <label class="rs-feld"><span>Aufschlüsseln</span>
          <select id="split">
            <option value="all">Bund, Land und Stadt</option>
            <option value="bund">nur Bund</option>
            <option value="land">nur {land.name}</option>
            <option value="gem">nur {stadt.name}</option>
          </select>
        </label>
        <label class="rs-schalter"><input id="ag" type="checkbox" /> Arbeitgeberanteil mitzählen</label>
        <label class="rs-schalter"><input id="shownetto" type="checkbox" /> Netto zeigen</label>
        <div class="rs-segment" id="unit" role="group" aria-label="Zeitraum">
          <button type="button" data-u="m" aria-pressed="true">pro Monat</button>
          <button type="button" data-u="y" aria-pressed="false">pro Jahr</button>
        </div>
      </div>
      <div class="rs-panel">
        <p class="hint">Diagramm seitlich wischen</p>
        <div class="rs-scroll"><svg id="s2" role="img" aria-label="Sankey-Diagramm deiner Abgaben: von Lohnsteuer, Soli, Kirchensteuer und Sozialversicherung über Bund, Land und Stadt in die Ausgabenbereiche. Alle Beträge stehen in der Tabelle weiter unten."></svg></div>
        <ul class="rs-legende" id="lg2"></ul>
      </div>
    </div>

    {arten && (
      <div class="figure">
        <h3>Was {stadt.name} tatsächlich ausgibt</h3>
        <p class="sub">Auszahlungen {arten.jahr}{arten.vorlaeufig ? ' (vorläufig)' : ''} nach Art, in € je Einwohner. Der Strich zeigt den Durchschnitt aller {arten.anzahl} kreisfreien Städte. Rechts dein Gemeindeanteil, nach denselben Anteilen verteilt.</p>
        <div class="rs-panel" id="arten"></div>
      </div>
    )}

    <details class="rs-aufklapper figure" data-neu-zeichnen>
      <summary><b>Alle Töpfe, sortiert</b><span id="toepfe-sum"></span></summary>
      <p class="sub" id="barsub"></p>
      <div class="rs-panel"><svg id="s3" role="img" aria-label="Sortiertes Balkendiagramm deiner Abgaben je Topf in Euro. Werte auch in der Tabelle unten."></svg>
      <ul class="rs-legende" id="lg3"></ul></div>
    </details>

    <details class="rs-aufklapper figure">
      <summary><b>Alle Posten als Tabelle</b><span id="tcount"></span></summary>
      <p class="sub" id="tsub"></p>
      <div class="rs-panel rs-scroll"><table class="rs-tabelle" id="tbl"><thead><tr><th>Posten</th><th>Anteil</th><th class="uy">€ / Monat</th></tr></thead><tbody></tbody></table></div>
    </details>
  </section>

  <section class="chapter" aria-labelledby="k3">
    <header class="rs-kapitel">
      <h2 id="k3"><span class="nr">3</span>Der Bundeshaushalt im Ganzen</h2>
      <p>Soll-Zahlen des Haushaltsgesetzes 2026. Über den Haushalt 2027 stimmt der Bundestag am {ABSTIMMUNG_2027} ab.</p>
    </header>
    <div class="rs-kennzahlen figure" id="bk"></div>

    <div class="figure">
      <h3>Woher das Geld kommt, wohin es geht</h3>
      <div class="steuerung">
        <div class="rs-segment" id="bundansicht" role="group" aria-label="Darstellung">
          <button type="button" data-ansicht="fluss" aria-pressed="true">Als Fluss</button>
          <button type="button" data-ansicht="flaeche" aria-pressed="false">Als Fläche</button>
        </div>
      </div>
      <p class="sub" id="bundsub">Einnahmen, Bundeshaushalt, Einzelpläne. Antippen oder Überfahren zeigt Beträge.</p>
      <div class="rs-panel">
        <div id="ansicht-fluss">
          <p class="hint">Diagramm seitlich wischen</p>
          <div class="rs-scroll"><svg id="s1" role="img" aria-label="Sankey-Diagramm: Steuern 387,2 Mrd €, Kredite 98,0 Mrd € und Sonstiges 39,4 Mrd € fließen in den Bundeshaushalt von 524,5 Mrd € und weiter in die Einzelpläne; größter Posten Arbeit und Soziales mit 197,3 Mrd €."></svg></div>
        </div>
        <div id="ansicht-flaeche" hidden>
          <svg id="s6" role="img" aria-label="Treemap des Bundeshaushalts 2026 nach Einzelplänen; Arbeit und Soziales belegt über ein Drittel der Fläche."></svg>
        </div>
        <ul class="rs-legende" id="lg1"></ul>
      </div>
    </div>

    <div class="figure">
      <h3>Was sich 2027 ändern soll</h3>
      <p class="sub">Regierungsentwurf 2027 ({ENTWURF_2027_GESAMT.toLocaleString('de-DE')} Mrd €) gegenüber Soll 2026, für die Einzelpläne mit veröffentlichten Entwurfszahlen. Noch nicht beschlossen.</p>
      <div class="rs-panel"><svg id="s9" role="img" aria-label="Balkendiagramm der Veränderungen 2027 gegenüber 2026: Verteidigung plus 27 Milliarden, Bundesschuld plus 10 Milliarden, Gesundheit minus 7,4 Milliarden."></svg></div>
    </div>

    <div class="figure">
      <h3>Entwicklung der Bundesausgaben</h3>
      <p class="sub">Kernhaushalt in Mrd €: 2025 und 2026 beschlossen, 2027 Entwurf, ab 2028 Finanzplan.</p>
      <div class="rs-panel"><svg id="s10" role="img" aria-label="Säulendiagramm: Bundesausgaben 2025 502,5, 2026 524,5, 2027 Entwurf 555,4, 2028 588,2, 2029 597,8, 2030 635,4 Milliarden Euro."></svg></div>
    </div>

    <p class="weiter"><a href="/rente/">Rentenbeitrag: Staat oder ETF? Vergleich mit deinen Angaben</a></p>
  </section>
</div>

<script type="application/json" id="daten" set:html={JSON.stringify(daten)}></script>
<script>
  import { start } from '../scripts/check';
  start();
</script>

<style>
  .hero {
    display: grid; gap: var(--space-12) var(--space-12); align-items: start;
    padding-block: var(--space-12) 0;
  }
  @media (min-width: 960px) {
    .hero { grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr); }
  }
  .eingabe { display: grid; gap: var(--space-6); min-width: 0; }
  @media (max-width: 600px) { .t-title { font-size: 38px; } .rs-satz { font-size: 19px; } }
  .mehr { max-width: 36em; }
  .mehr .rs-felder { align-items: end; }
  .hinweis { margin: var(--space-3) 0 0; font-size: 14px; color: var(--ink-3); }
  .ergebnis { margin: 0; font-size: 21px; line-height: 1.7; max-width: 32em; }

  .hundert { margin: 0; display: grid; gap: var(--space-4); min-width: 0; }
  .hundert figcaption { font: 650 19px/1.35 var(--font-text); }
  .hundert .rs-raster { max-width: 340px; }

  .rs-kapitel .nr { color: var(--ink-3); margin-right: 0.45em; }
  .steuerung { display: flex; flex-wrap: wrap; align-items: end; gap: var(--space-3) var(--space-6); margin: var(--space-4) 0; }
  .steuerung .rs-feld { min-width: 220px; }
  .figure > h3 { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .weiter { font-size: 19px; font-weight: 600; }
</style>
