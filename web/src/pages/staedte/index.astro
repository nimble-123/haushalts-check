---
import Base from '../../layouts/Base.astro';
import { LAENDER, STAEDTE } from '../../data';

const gruppen = LAENDER.map((l) => ({ land: l, staedte: STAEDTE.filter((s) => s.land === l.code) })).filter((g) => g.staedte.length);
---
<Base title="Alle kreisfreien Städte | Haushalts-Check" description={`Haushalts-Check für alle ${STAEDTE.length} kreisfreien Städte in Deutschland: wie viel deiner Lohnsteuer an deine Stadt, dein Land und den Bund geht.`}>
  <div class="page">
    <h1>Alle {STAEDTE.length} kreisfreien Städte</h1>
    <p class="prose lead">Wähl deine Stadt. Für Landkreise und kreisangehörige Gemeinden gibt es noch keine eigene Seite; dort passt die Stadt deines Landes als Näherung.</p>
    <div class="cols">
      {gruppen.map((g) => (
        <section>
          <h2>{g.land.name}</h2>
          <ul>
            {g.staedte.map((s) => <li><a href={`/stadt/${s.slug}/`}>{s.name}</a></li>)}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>
<style>
  h1 { font-size: clamp(34px, 6vw, 56px); margin: 40px 0 12px; }
  .lead { color: var(--ink-2); margin-bottom: 40px; }
  .cols { columns: 260px; column-gap: 40px; }
  section { break-inside: avoid; margin-bottom: 28px; }
  h2 { font-size: 20px; padding-bottom: 6px; border-bottom: 2px solid var(--ink); margin-bottom: 4px; }
  ul { list-style: none; margin: 0; padding: 0; }
  a { display: flex; align-items: center; min-height: 40px; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--rule); }
  a:hover { color: var(--pen); }
</style>
