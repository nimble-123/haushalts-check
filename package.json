{
  "name": "haushalts-check",
  "version": "0.0.1",
  "private": true,
  "description": "Wohin geht deine Lohnsteuer? Interaktive Aufteilung auf Bund, Land und Stadt für alle kreisfreien Städte.",
  "license": "MIT",
  "author": "Nils Lutz",
  "homepage": "https://haushalts-check.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimble-123/haushalts-check.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "tokens": "node design-system/build-tokens.ts",
    "daten:laender": "node pipeline/laender.ts",
    "daten:staedte": "node pipeline/staedte.ts",
    "daten:ausgabearten": "node --env-file=.env.local pipeline/ausgabearten.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "npm run build && npx -y @lhci/cli@0.16.0 autorun"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "astro": "^7.4.7",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^26.6.6",
    "exceljs": "^4.4.0",
    "jsdom": "26.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
